{
  "name": "gitgotchi",
  "version": "0.1.0",
  "description": "Pixel pet that lives on your desktop and evolves with your GitHub activity",
  "license": "MIT",
  "author": {
    "name": "Nicolás Vázquez",
    "email": "157853579+nicvazquezdev@users.noreply.github.com",
    "url": "https://github.com/nicvazquezdev"
  },
  "homepage": "https://github.com/nicvazquezdev/gitgotchi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicvazquezdev/gitgotchi.git"
  },
  "bugs": {
    "url": "https://github.com/nicvazquezdev/gitgotchi/issues"
  },
  "keywords": [
    "electron",
    "github",
    "pixel-art",
    "desktop-pet",
    "tamagotchi",
    "gamification"
  ],
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electronmon .",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test": "node --test",
    "shots": "electron scripts/shots.js",
    "shots:check": "electron scripts/visual-check.js",
    "shots:update": "electron scripts/visual-check.js --update",
    "smoke": "electron scripts/smoke.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electronmon": "^2.0.4",
    "prettier": "^3.9.10"
  },
  "private": true,
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "electron-updater": "^6.8.11"
  },
  "electronmon": {
    "patterns": [
      "!.claude/**",
      "!test/**"
    ]
  }
}
