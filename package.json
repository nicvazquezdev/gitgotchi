{
  "name": "gitgotchi",
  "version": "0.1.0",
  "description": "Pixel pet that lives on your desktop and evolves with your GitHub activity",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electronmon .",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test": "node --test",
    "shots": "electron scripts/shots.js",
    "shots:check": "electron scripts/visual-check.js",
    "shots:update": "electron scripts/visual-check.js --update"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electronmon": "^2.0.4",
    "prettier": "^3.9.10"
  },
  "private": true,
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0"
  },
  "electronmon": {
    "patterns": [
      "!.claude/**",
      "!test/**"
    ]
  }
}
